rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document tree.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /account/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /player/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

       match /quests/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Global leaderboard: each user owns their own entry (doc id = uid).
    // All authenticated users can read the full collection for rankings;
    // users can only create/update/delete their own entry.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
